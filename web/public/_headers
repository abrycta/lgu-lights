# Cloudflare Pages response headers. Docs: https://developers.cloudflare.com/pages/configuration/headers/
# When several rules match, values of the same header are joined with a comma, so Cache-Control is set
# only on non-overlapping paths below.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Everything is same-origin in M1 (no external basemap). 'wasm-unsafe-eval' is needed for the what-if module.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# The app's pages name their canonical URL on the custom domain (the SPA serves one index.html for every
# path, so the header is per path rather than a <link> in the shell; the root's is in the "/" rule below).
/about
  Link: <https://lights.krtmtthw.dev/about>; rel="canonical"

# The production *.pages.dev host is a duplicate of lights.krtmtthw.dev: keep it out of search results.
https://lgu-lights.pages.dev/*
  X-Robots-Tag: noindex

# Vite emits content-hashed file names here, so they never change in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data versions are immutable folders (v0/, v1/, ...): a new release is a new folder.
/data/v*
  Cache-Control: public, max-age=31536000, immutable

# Vector tiles are uncompressed MVT in a z/x/y directory (Pages ignores Range, so no PMTiles).
/data/:version/tiles/*
  Content-Type: application/x-protobuf

# The what-if panel snapshot is a raw binary; Cloudflare does not compress application/octet-stream, so it
# is served as application/x-protobuf, a type on Cloudflare's compressible list (771 kB raw, about 540 kB br).
# The worker reads it with arrayBuffer(), so the declared type does not matter to the app.
/data/:version/whatif/snapshot.bin
  Content-Type: application/x-protobuf

# The pointer to the current data version: short cache so a new release shows up quickly.
/data/latest.json
  Cache-Control: public, max-age=60, must-revalidate

# The what-if module has a stable name: short TTL.
/wasm/*
  Cache-Control: public, max-age=300
  Content-Type: application/wasm

# Akari's pre-paint theme script (stable name, render-blocking): short TTL so upgrades land quickly.
/theme-init.js
  Cache-Control: public, max-age=300

# Old-host redirect (stable name, render-blocking).
/host-redirect.js
  Cache-Control: public, max-age=300

# The HTML entry point must always revalidate so new deploys show up at once.
/
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://lights.krtmtthw.dev/>; rel="canonical"
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The frozen embed (embed.html, served at /embed) that krtmtthw.dev frames: the global framing rules are
# detached and the CSP set again with frame-ancestors https://krtmtthw.dev (and no WASM: no what-if there).
/embed
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors https://krtmtthw.dev; base-uri 'self'; object-src 'none'
  Cache-Control: public, max-age=0, must-revalidate

# The embed's packed view (scripts/build-embed.mjs): content-hashed names, never changed in place.
/embed-data/*
  Cache-Control: public, max-age=31536000, immutable
