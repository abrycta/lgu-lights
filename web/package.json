{
  "name": "lgu-lights-web",
  "private": true,
  "version": "0.1.0",
  "description": "Lights web app: a static map of poverty incidence for every Philippine city and municipality, PSA official figures and labelled model estimates.",
  "author": "Kurt",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "link-data": "scripts/link-data.sh",
    "build:wasm": "scripts/build-wasm.sh",
    "lint": "eslint .",
    "build:embed": "node scripts/build-embed.mjs",
    "gen:rounds": "node scripts/gen-rounds.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install ${CI:+--with-deps} chromium"
  },
  "dependencies": {
    "@abrycta/akari": "^0.20.1",
    "lucide-react": "^1.67.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/vt-pbf": "^4.3.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "pbf": "^5.1.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "@scarf/scarf": false
  }
}
